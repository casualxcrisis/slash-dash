[sub_resource type="GDScript" id="GDScript_ia2pv"]
script/source = "extends AnimatableBody3D




func _on_pickup_area_area_entered(area: Area3D) -> void:
	if area.is_in_group(\"player\"):
		if Global.player_health < 100:
			Global.player_health += Global.health_amt
			print(\"Player got 10 health.\")
		elif Global.player_health == 100:
			Global.player_score += Global.health_scr
			print(\"Health is full, 10 pts!\")
		self.queue_free()
"

